# Template of /etc/cinemawatch/backup.env on the server (docs/SAAS_INFRA.md §4.25). Root only, mode 600; never in git.
# One KEY=value per line, no quotes, no spaces around "=".

# Backblaze B2 application key: bucket = the backup bucket, access = Write Only. Both values are secrets.
B2_KEY_ID=
B2_KEY=
B2_BUCKET=

# age public key (age1...): the server encrypts with it but cannot decrypt. The private key (AGE-SECRET-KEY-1...)
# lives only in the password manager - without it no backup can be read.
AGE_RECIPIENT=

# Healthchecks.io ping address of the check "cinemawatch-backup" (a secret).
HEARTBEAT_URL=
