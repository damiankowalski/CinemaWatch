# Template of /opt/cinemawatch/.env on the server (docs/SAAS_INFRA.md). Copy it, fill it in on the server, keep it
# readable by root only (chmod 600). Never commit the filled-in file: it holds secrets and personal data.
# One KEY=value per line, no quotes, no spaces around "=".

# Image version to run (a tag published by .github/workflows/web-image.yml, e.g. 0.5.0 or 0.5.0-beta.1).
CINEMAWATCH_VERSION=0.5.0

# Database password: letters and digits only (it goes into a connection string), e.g. from: openssl rand -hex 32
POSTGRES_PASSWORD=

# Public address and the owner's e-mail (the owner's account is created and invited at the first start).
SAAS_BASE_URL=https://staging-cinemawatch.damiankowalski.pl
SAAS_OWNER_EMAIL=

# Background checks of Cinema City: true in exactly one environment on this server.
SAAS_POLLER_ENABLED=true

# "Dead man's switch" ping address (Healthchecks.io); empty = off. A secret: whoever has it can fake the pings.
SAAS_HEARTBEAT_URL=

# E-mail provider (SMTP): Resend (docs/SAAS_INFRA.md §1.5). MAIL_SECURITY: StartTls (port 587) or SslOnConnect (465).
# MAIL_PASSWORD is a Resend API key with sending access to mail.damiankowalski.pl only. A secret.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURITY=StartTls
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=cinemawatch@mail.damiankowalski.pl
MAIL_FROM_NAME=CinemaWatch

# Cloudflare Tunnel token: Zero Trust > Networking > Tunnels > staging-cinemawatch (install command). A secret.
TUNNEL_TOKEN=
