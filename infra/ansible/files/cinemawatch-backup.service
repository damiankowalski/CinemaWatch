# Managed by infra/ansible (docs/SAAS_INFRA.md §4.25): one backup of the CinemaWatch database per start.
[Unit]
Description=CinemaWatch database backup (pg_dump, age, Backblaze B2)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cinemawatch-backup
Nice=10
IOSchedulingClass=idle
