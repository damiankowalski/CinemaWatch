# Managed by infra/ansible (docs/SAAS_INFRA.md §4.25): daily at 02:30 UTC, before the 03:30 reboot window.
[Unit]
Description=Daily CinemaWatch database backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=5min
# A run missed while the server was off is made up at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
