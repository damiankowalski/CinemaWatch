<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner. Run: dotnet run (from this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CinemaWatch.Core\CinemaWatch.Core.csproj" />
    <ProjectReference Include="..\..\src\CinemaWatch.ViewModels\CinemaWatch.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cases shared with the site's JavaScript tests (one file, linked - not copied - into this project). -->
    <None Include="..\Fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
