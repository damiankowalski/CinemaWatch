<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free tests for the SaaS probe. Run from the repository root: dotnet run (project tests/CinemaWatch.Probe.Tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- An unreachable NuGet vulnerability feed must not fail the build. -->
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
    <!-- Same globalization mode as the probe, so the tests run under the server's conditions. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\CinemaWatch.Probe\CinemaWatch.Probe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the desktop tests: the minimal runner and the captured API responses. -->
    <Compile Include="..\CinemaWatch.Tests\TestRunner.cs" Link="TestRunner.cs" />
    <None Include="..\CinemaWatch.Tests\Fixtures\**\*.json" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
