<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the SaaS (CinemaWatch.Server and CinemaWatch.Web). Run from the repository root:
      dotnet run (project tests/CinemaWatch.Saas.Tests)
    Database and web tests need a PostgreSQL connection in CINEMAWATCH_TEST_DB (role with CREATEDB); without it they
    are skipped. Each run creates its own database and drops it at the end (src/CinemaWatch.Web/README.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs the real web app in memory (WebApplicationFactory); no test framework needed. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CinemaWatch.Web\CinemaWatch.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the desktop tests: the minimal runner. -->
    <Compile Include="..\CinemaWatch.Tests\TestRunner.cs" Link="TestRunner.cs" />
  </ItemGroup>

</Project>
