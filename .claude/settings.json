{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet run --project tests/*)",
      "Bash(dotnet tool restore)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch --show-current)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr view)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checks)",
      "Bash(gh pr list *)",
      "Bash(gh pr list)",
      "Bash(gh run list *)",
      "Bash(gh run list)",
      "Bash(gh run view *)",
      "Bash(gh auth status)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr merge)",
      "Bash(gh pr close *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh auth token *)",
      "Bash(gh auth token)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh codespace *)",
      "Bash(gh extension *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(./.env)",
      "Read(./**/secrets.json)"
    ]
  }
}
