@page "/Account/Manage/ChangePassword"
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@T("Zmiana hasła", "Change password") – CinemaWatch</PageTitle>

<section class="narrow">
    <h1>@T("Zmień hasło", "Change password")</h1>
    <ErrorList Errors="errors" />

    <EditForm Model="Input" method="post" OnSubmit="ChangeAsync" FormName="change-password" class="form">
        <label for="current">@T("Obecne hasło", "Current password")</label>
        <InputText id="current" type="password" @bind-Value="Input.Current" autocomplete="current-password" required />

        <label for="password">@T("Nowe hasło", "New password")</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" minlength="12" required aria-describedby="password-hint" />
        <p id="password-hint" class="hint">@T("Co najmniej 12 znaków.", "At least 12 characters.")</p>

        <label for="repeat">@T("Powtórz nowe hasło", "Repeat the new password")</label>
        <InputText id="repeat" type="password" @bind-Value="Input.Repeated" autocomplete="new-password" minlength="12" required />

        <button type="submit" class="button primary">@T("Zmień hasło", "Change password")</button>
    </EditForm>

    <p class="aside"><a href="Account/Manage">@T("Wróć do konta", "Back to your account")</a></p>
</section>

@code {
    private IReadOnlyList<string> errors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        errors = FormChecks.NewPassword(Input.Password, Input.Repeated);
        if (string.IsNullOrEmpty(Input.Current))
            errors = [T("Podaj obecne hasło.", "Enter your current password."), .. errors];
        if (errors.Count > 0)
            return;

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.Current, Input.Password);
        if (!result.Succeeded)
        {
            errors = result.Errors.Select(e => e.Description).ToList();
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToWithStatus("Account/Manage", StatusMessageKind.Success, T("Hasło zmienione.", "Password changed."), HttpContext);
    }

    private sealed class InputModel
    {
        public string Current { get; set; } = "";
        public string Password { get; set; } = "";
        public string Repeated { get; set; } = "";
    }
}
