@page "/Account/Manage"
@inject UserManager<AppUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IOptions<CinemaWatch.Server.Mail.MailOptions> Mail

<PageTitle>@T("Konto", "Account") – CinemaWatch</PageTitle>

<section class="narrow">
    <h1>@T("Twoje konto", "Your account")</h1>
    <StatusMessage />

    @if (user is not null)
    {
        <dl class="facts">
            <dt>E-mail</dt>
            <dd>@user.Email</dd>
            <dt>@T("Język e-maili", "E-mail language")</dt>
            <dd>@(user.Language == "en" ? "English" : "polski") <span class="hint">@T("(zmienisz go przełącznikiem PL / EN u góry)", "(change it with the PL / EN switch at the top)")</span></dd>
        </dl>

        <h2>@T("Powiadomienia e-mail", "E-mail notifications")</h2>
        <p>@T("Powiadomienia o wolnych miejscach przychodzą na ten adres. Testowy e-mail pokaże, czy dociera i czy nie trafia do spamu (najwyżej raz na 5 minut).",
              "Notifications about free seats go to this address. A test e-mail shows whether it arrives and stays out of spam (at most once every 5 minutes).")</p>
        @if (Mail.Value.IsLocal)
        {
            <p class="hint">@T("Tryb testowy: serwer pocztowy działa na tym komputerze, więc e-maile trafiają do lokalnej skrzynki testowej, a nie do prawdziwej skrzynki.",
                               "Test mode: the mail server runs on this computer, so e-mails go to a local test inbox, not to the real mailbox.")</p>
        }
        <form action="Account/Manage/TestMail" method="post">
            <AntiforgeryToken />
            <button type="submit" class="button">@T("Wyślij testowy e-mail", "Send a test e-mail")</button>
        </form>

        <h2>@T("Hasło", "Password")</h2>
        <p><a class="button" href="Account/Manage/ChangePassword">@T("Zmień hasło", "Change password")</a></p>

        <h2>@T("Twoje dane", "Your data")</h2>
        <p>@T("Możesz pobrać dane konta w pliku JSON albo usunąć konto razem ze wszystkimi danymi.", "You can download your account's data as a JSON file or delete the account with all its data.")</p>
        <div class="actions">
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken />
                <button type="submit" class="button">@T("Pobierz moje dane", "Download my data")</button>
            </form>
            <a class="button danger-outline" href="Account/Manage/DeleteAccount">@T("Usuń konto", "Delete account")</a>
        </div>
    }
</section>

@code {
    private AppUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() => user = await UserManager.GetUserAsync(HttpContext.User);
}
