@page "/Account/SetPassword"
@attribute [AllowAnonymous]
@inject AccountService Accounts
@inject IdentityRedirectManager RedirectManager

@* The page behind the links in the invitation and password-reset e-mails. *@

<PageTitle>@Title – CinemaWatch</PageTitle>

<section class="narrow">
    <h1>@Title</h1>

    @if (!linkValid || user is null)
    {
        <p class="status error" role="alert">
            @T("Link jest nieważny albo wygasł. Linki działają 24 godziny i tylko raz.", "The link is invalid or has expired. Links work for 24 hours and only once.")
        </p>
        <p><a class="button" href="Account/ForgotPassword">@T("Poproś o nowy link", "Ask for a new link")</a></p>
    }
    else
    {
        <p class="lead">
            @(user.IsPending
                ? T("Ustaw hasło, aby aktywować konto. Najwygodniej wygenerować je w menedżerze haseł.", "Set a password to activate your account. A password manager can generate one for you.")
                : T("Wpisz nowe hasło do konta.", "Enter a new password for your account."))
        </p>

        <ErrorList Errors="errors" />

        <EditForm Model="Input" method="post" OnSubmit="SaveAsync" FormName="set-password" class="form">
            <label for="email">E-mail</label>
            <input id="email" type="email" value="@user.Email" autocomplete="username" readonly />

            <label for="password">@T("Nowe hasło", "New password")</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" minlength="12" required aria-describedby="password-hint" />
            <p id="password-hint" class="hint">@T("Co najmniej 12 znaków.", "At least 12 characters.")</p>

            <label for="repeat">@T("Powtórz hasło", "Repeat the password")</label>
            <InputText id="repeat" type="password" @bind-Value="Input.Repeated" autocomplete="new-password" minlength="12" required />

            <button type="submit" class="button primary">
                @(user.IsPending ? T("Ustaw hasło i aktywuj konto", "Set password and activate") : T("Zapisz nowe hasło", "Save new password"))
            </button>
        </EditForm>
    }
</section>

@code {
    private AppUser? user;
    private bool linkValid;
    private IReadOnlyList<string> errors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "user")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private string Title => user is { IsPending: true } && linkValid
        ? T("Aktywuj konto", "Activate your account")
        : T("Ustaw nowe hasło", "Set a new password");

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await Accounts.FindAsync(UserId);
        linkValid = user is not null && await Accounts.IsSetPasswordLinkValidAsync(user, Code);
    }

    private async Task SaveAsync()
    {
        if (!linkValid || user is null)
            return;

        errors = FormChecks.NewPassword(Input.Password, Input.Repeated);
        if (errors.Count > 0)
            return;

        var result = await Accounts.SetPasswordAsync(user.Id, Code!, Input.Password);
        if (!result.Succeeded)
        {
            errors = result.Errors.Select(e => e.Description).ToList();
            return;
        }

        RedirectManager.RedirectToWithStatus("Account/Login", StatusMessageKind.Success,
            T("Hasło zapisane. Możesz się zalogować.", "Password saved. You can sign in now."), HttpContext);
    }

    private sealed class InputModel
    {
        public string Password { get; set; } = "";
        public string Repeated { get; set; } = "";
    }
}
