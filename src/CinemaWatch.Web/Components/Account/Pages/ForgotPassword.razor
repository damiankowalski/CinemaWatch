@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@inject PasswordHelpQueue HelpQueue
@inject IdentityRedirectManager RedirectManager

<PageTitle>@T("Nie pamiętasz hasła?", "Forgot your password?") – CinemaWatch</PageTitle>

<section class="narrow">
    <h1>@T("Nie pamiętasz hasła?", "Forgot your password?")</h1>
    <p class="lead">@T("Podaj adres e-mail konta. Wyślemy link do ustawienia nowego hasła.", "Enter your account's e-mail address. We will send a link to set a new password.")</p>

    <StatusMessage Message="@error" />

    <EditForm Model="Input" method="post" OnSubmit="Send" FormName="forgot-password" class="form">
        <label for="email">E-mail</label>
        <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" required />
        <button type="submit" class="button primary">@T("Wyślij link", "Send link")</button>
    </EditForm>

    <p class="aside"><a href="Account/Login">@T("Wróć do logowania", "Back to sign-in")</a></p>
</section>

@code {
    private string? error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private void Send()
    {
        if (FormChecks.Email(Input.Email) is { } problem)
        {
            error = problem;
            return;
        }

        // Only queued (PasswordHelpQueue): the answer is the same, and as fast, whether the address has an account or
        // not; the e-mail, if any, follows in the background within the limits of PasswordHelpLimits.
        HelpQueue.Enqueue(Input.Email);

        RedirectManager.RedirectToWithStatus("Account/Login", StatusMessageKind.Success,
            T("Jeśli to konto istnieje, wysłaliśmy na nie link. Sprawdź skrzynkę, także folder spam.",
              "If the account exists, we have sent a link to it. Check your inbox, including the spam folder."),
            HttpContext);
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = "";
    }
}
