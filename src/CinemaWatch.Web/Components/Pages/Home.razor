@page "/"

<PageTitle>@T("Profile", "Profiles") – CinemaWatch</PageTitle>

<h1>@T("Profile", "Profiles")</h1>
<StatusMessage />

<section class="empty">
    <BrandMark />
    <p>
        @T("Tu pojawią się profile z aplikacji CinemaWatch na Windows: seanse i miejsca, których pilnujesz. Gdy któreś się zwolni, dostaniesz e-mail z linkiem do zakupu.",
           "Your profiles from the CinemaWatch Windows app will appear here: the screenings and seats you watch. When one frees up, you get an e-mail with a booking link.")
    </p>
    <p class="hint">@T("Import plików .cinemawatch.json będzie dostępny w kolejnej wersji.", "Importing .cinemawatch.json files arrives in the next version.")</p>
</section>
