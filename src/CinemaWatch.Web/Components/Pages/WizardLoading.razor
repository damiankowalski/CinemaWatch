@page "/wizard/loading/{Id:guid}"
@using CinemaWatch.Server.Wizard
@using CinemaWatch.Web.Components.Wizard
@inject WizardJobs Jobs
@inject UserManager<AppUser> UserManager
@inject IdentityRedirectManager RedirectManager

@*
    A wizard loading's progress (docs/SAAS.md §5.2): it runs in the background on the server, because a large search
    takes over a minute and Cloudflare ends a request after 100 s. No JavaScript: the page reloads itself every
    2 seconds while the loading runs and then opens the next step. The wizard's state rides along in the address.
*@

<PageTitle>@T("Wczytywanie", "Loading") – CinemaWatch</PageTitle>

@if (job is { State: WizardJobState.Running })
{
    <HeadContent><meta http-equiv="refresh" content="@($"{RefreshSeconds}; url={WizardTexts.LoadingUrl(Id, state, target == 4 ? 4 : null)}")" /></HeadContent>
}

<div class="page-head">
    <h1>@WizardTexts.Heading(state)</h1>
</div>
<WizardSteps Current="target" Furthest="state.Furthest" InForm="false" />
<StatusMessage />

@if (job is null)
{
    <p class="status error" role="alert">
        @T("Tego wczytywania już nie ma (minęło sporo czasu albo serwer był restartowany).", "This loading is gone (a while has passed or the server was restarted).")
    </p>
    <div class="actions">
        <a class="button primary" href="@WizardTexts.StepUrl(target - 1, state)">@BackText</a>
    </div>
}
else
{
    <p class="lead">@(target >= 3 ?T($"Mapy sal: {Count(job.Total, "seans", "seanse", "seansów", "screening", "screenings")}", $"Hall maps: {Count(job.Total, "seans", "seanse", "seansów", "screening", "screenings")}") : T("Repertuar: ", "Repertoire: ") + WizardTexts.Search(state))</p>
    <div class="loading" role="status">
        <progress max="@job.Total" value="@job.Done">@job.Done / @job.Total</progress>
        <p>
            @T($"Wczytano {job.Done} z {job.Total}", $"Loaded {job.Done} of {job.Total}")@(job.FromCache > 0 ? T($" (z pamięci serwera: {job.FromCache})", $" (from the server's memory: {job.FromCache})") : "")@(job.Failed > 0 ? T($", błędy: {job.Failed}", $", failed: {job.Failed}") : "").
        </p>
    </div>

    @if (job.State == WizardJobState.Running)
    {
        <p class="hint">
            @T("Zapytania do Cinema City idą jedno po drugim, z sekundową przerwą. Strona odświeża się sama i otworzy następny krok.",
               "The requests to Cinema City go one after the other, a second apart. The page refreshes itself and opens the next step.")
        </p>
    }
    else if (job.State == WizardJobState.Stopped)
    {
        <p class="status error" role="alert">@WizardTexts.StopReason(job.StopReason!.Value, job.RetryAt)</p>
        <div class="actions">
            @if (job.Done > job.Failed)
            {
                <a class="button primary" href="@WizardTexts.AfterLoadingUrl(target, state)">@T("Pokaż to, co się wczytało", "Show what was loaded")</a>
            }
            <a class="button" href="@WizardTexts.StepUrl(target - 1, state)">@BackText</a>
        </div>
    }
    else
    {
        @* Finished with every item failed (otherwise the page has already moved on to step 2). *@
        <p class="status error" role="alert">
            @(target >= 3
                ?T("Nie udało się wczytać map sal: Cinema City nie odpowiedziało poprawnie. Spróbuj ponownie za chwilę.",
                    "Could not load the hall maps: Cinema City did not answer properly. Try again in a moment.")
                : T("Nie udało się wczytać repertuaru: Cinema City nie odpowiedziało poprawnie. Spróbuj ponownie za chwilę.",
                    "Could not load the repertoire: Cinema City did not answer properly. Try again in a moment."))
        </p>
        <div class="actions">
            <a class="button primary" href="@WizardTexts.StepUrl(target - 1, state)">@BackText</a>
        </div>
    }
}

@code {
    /// <summary>How often the page reloads itself while the loading runs.</summary>
    private const int RefreshSeconds = 2;

    private WizardJobView? job;

    /// <summary>The step the loading leads to: 2 after the repertoire, 3 after the hall maps, 4 when started there.</summary>
    private int target = 2;

    private string BackText => target switch
    {
        4 => T("Wróć do miejsc", "Back to the seats"),
        3 => T("Wróć do wyboru seansów", "Back to the screenings"),
        _ => T("Wróć do wyboru terminu", "Back to the dates"),
    };
    private WizardState state = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    protected override void OnInitialized()
    {
        var query = HttpContext.Request.Query;
        state = WizardState.Read(name => query[name]);
        // Another account's loading looks exactly like a missing one.
        job = Jobs.Find(Id, UserManager.GetUserId(HttpContext.User)!);
        target = query["to"].ToString() == "4" ? 4
            : job?.Request is ScreeningsRequest || (job is null && state.Furthest >= 3) ? 3 : 2;
        state = state with { Furthest = Math.Max(state.Furthest, target) };
        if (job is { State: WizardJobState.Finished } finished && finished.Done > finished.Failed)
            RedirectManager.RedirectTo(WizardTexts.AfterLoadingUrl(target, state));
    }
}
