{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "AllowedHosts": "*",
  "Saas": {
    "BaseUrl": "",
    "OwnerEmail": "",
    "Limits": {
      "MaxProfiles": 5,
      "MaxScreeningsPerProfile": 20,
      "MinIntervalMinutes": 10
    },
    "Poller": {
      "Enabled": true,
      "Source": "CinemaCity",
      "TickSeconds": 30,
      "JitterPercent": 20,
      "RequestGapMinSeconds": 3,
      "RequestGapMaxSeconds": 6,
      "ManualGapMinSeconds": 1,
      "ManualGapMaxSeconds": 2,
      "RequestsPerHour": 120,
      "ManualFreshMinutes": 1,
      "FirstBlockPauseMinutes": 60,
      "MaxBlockPauseMinutes": 1440,
      "ReuseScreeningDetails": false,
      "CheckLogDays": 30,
      "HistoryDays": 90
    }
  },
  "Mail": {
    "Host": "localhost",
    "Port": 2525,
    "Security": "None",
    "FromAddress": "cinemawatch@localhost",
    "FromName": "CinemaWatch"
  }
}
