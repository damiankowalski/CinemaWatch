<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SaaS web app (MVP 0, docs/SAAS.md §5.1): accounts by invitation, profiles, checks and notification history. Static server-side
    rendering (Blazor, no WebAssembly, no JavaScript); hosts the background services of CinemaWatch.Server.
    Versioned with the SaaS, not with the desktop app. Local setup: README.md in this folder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CinemaWatch.Web</RootNamespace>
    <Version>0.4.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- An unreachable vulnerability feed or a low/moderate advisory must not fail the build; high and critical do. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902</WarningsNotAsErrors>
    <!-- Development secrets (connection string, owner e-mail) live in %APPDATA%\Microsoft\UserSecrets\cinemawatch-web. -->
    <UserSecretsId>cinemawatch-web</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed only by "dotnet ef" (migrations); not part of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CinemaWatch.Server\CinemaWatch.Server.csproj" />
  </ItemGroup>

</Project>
