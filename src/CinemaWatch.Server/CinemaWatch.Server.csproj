<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SaaS: server-side logic without HTTP - data (EF Core + PostgreSQL), accounts and e-mail; later the poller and the
    notifier. Hosted by CinemaWatch.Web in MVP 0; a separate worker host can reference it later (docs/SAAS.md §6).
    Versioned with the SaaS, not with the desktop app (the root Directory.Build.props holds the desktop version).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CinemaWatch.Server</RootNamespace>
    <Version>0.2.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- An unreachable vulnerability feed or a low/moderate advisory must not fail the build; high and critical do. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CinemaWatch.Core\CinemaWatch.Core.csproj" />
  </ItemGroup>

</Project>
