<Window x:Class="CinemaWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CinemaWatch.ViewModels;assembly=CinemaWatch.ViewModels"
        xmlns:views="clr-namespace:CinemaWatch.Views"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/CinemaWatch.ico"
        Width="1280" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Each wizard page is a view model; WPF picks the matching view. -->
        <DataTemplate DataType="{x:Type vm:DatesStepViewModel}">
            <views:DatesStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScreeningsStepViewModel}">
            <views:ScreeningsStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeatsStepViewModel}">
            <views:SeatsStepView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SummaryStepViewModel}">
            <views:SummaryStepView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="CinemaWatch" Style="{StaticResource AppTitleText}" />
                <TextBlock Text="{Binding AppSubtitle, Source={StaticResource T}}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding NewProfile, Source={StaticResource T}}" Command="{Binding NewProfileCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding OpenProfile, Source={StaticResource T}}" Command="{Binding OpenProfileCommand}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          DisplayMemberPath="Name" MinWidth="110" VerticalAlignment="Center"
                          ToolTip="{Binding LanguageToolTip, Source={StaticResource T}}" />
            </StackPanel>
        </Grid>

        <!-- Step indicator: each step is clickable (visited steps and the next one) -->
        <ItemsControl Grid.Row="1" Margin="-8,16,0,16" ItemsSource="{Binding Steps}" Focusable="False">
            <ItemsControl.Resources>
                <Style x:Key="StepButtonStyle" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" Background="Transparent" CornerRadius="18" Padding="8,4,12,4">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="Background" Value="{StaticResource NeutralBackgroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Back" Property="Opacity" Value="0.45" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ItemsControl.Resources>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding NavigateCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,8,0"
                            Style="{StaticResource StepButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Dot" Width="28" Height="28" CornerRadius="14" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontSize="13" Visibility="Collapsed"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Title" Text="{Binding Title}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Opacity="0.65" />
                        </StackPanel>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Title" Property="Opacity" Value="0.9" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Title" Property="Opacity" Value="1" />
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Current page -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Error -->
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource ErrorBar}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel VerticalAlignment="Center" Margin="0,0,16,0" LastChildFill="True">
                <ProgressBar DockPanel.Dock="Left" Width="120" IsIndeterminate="True" Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding Back, Source={StaticResource T}}" MinWidth="120" Margin="0,0,8,0" Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding Next, Source={StaticResource T}}" MinWidth="120" Command="{Binding NextCommand}" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
