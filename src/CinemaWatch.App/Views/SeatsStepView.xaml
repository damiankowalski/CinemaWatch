<UserControl x:Class="CinemaWatch.Views.SeatsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CinemaWatch.ViewModels;assembly=CinemaWatch.ViewModels">

    <UserControl.Resources>

        <!-- Positions items on a Canvas using the view model's Left/Top (plan units). -->
        <Style x:Key="CanvasItemStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>

        <!-- Seat: fill shows occupancy, gold ring shows that the seat is watched. -->
        <Style x:Key="SeatToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Circle" Margin="5" Fill="{StaticResource SeatTakenBrush}" />
                            <Ellipse x:Name="Hover" Margin="5" Fill="{StaticResource SeatHoverBrush}" Visibility="Collapsed" />
                            <Ellipse x:Name="Ring" Margin="1" Stroke="{StaticResource SeatWatchedBrush}"
                                     StrokeThickness="7" Visibility="Collapsed" />
                            <TextBlock x:Name="SeatText" Text="{Binding Text}" FontSize="24" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource SeatTakenTextBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFree}" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{StaticResource SeatFreeBrush}" />
                                <Setter TargetName="SeatText" Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row number: click toggles the whole row. Outline = part of the row watched, filled = whole row. -->
        <Style x:Key="RowLabelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Margin="3" CornerRadius="27" Background="Transparent"
                                BorderThickness="4" BorderBrush="Transparent">
                            <TextBlock x:Name="RowText" Text="{Binding Label}" FontSize="28" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource RowLabelHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource SeatWatchedBrush}" />
                                <Setter TargetName="RowText" Property="Foreground" Value="{StaticResource SeatWatchedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource SeatWatchedBrush}" />
                                <Setter TargetName="RowText" Property="Foreground" Value="Black" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The hall map, scaled to the available space. -->
        <DataTemplate DataType="{x:Type vm:HallMapViewModel}">
            <Viewbox Stretch="Uniform">
                <Grid Width="{Binding Width}" Height="{Binding Height}">
                    <Canvas>
                        <StackPanel Canvas.Left="{Binding ScreenLeft}" Canvas.Top="{Binding ScreenTop}"
                                    Width="{Binding ScreenWidth}">
                            <Border Height="{Binding ScreenBarHeight}" CornerRadius="9" Opacity="0.85"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{Binding Screen, Source={StaticResource T}}" FontSize="28" FontWeight="SemiBold" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Canvas>

                    <ItemsControl ItemsSource="{Binding RowLabels}" Background="{x:Null}" Focusable="False"
                                  ItemContainerStyle="{StaticResource CanvasItemStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="{Binding Size}" Height="{Binding Size}" Command="{Binding ToggleCommand}"
                                        ToolTip="{Binding ToolTip}" Style="{StaticResource RowLabelButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding SeatViews}" Background="{x:Null}" Focusable="False"
                                  ItemContainerStyle="{StaticResource CanvasItemStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Width="{Binding Size}" Height="{Binding Size}"
                                              IsChecked="{Binding IsWatched, Mode=TwoWay}"
                                              ToolTip="{Binding ToolTip}" Style="{StaticResource SeatToggleStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Viewbox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Screening tabs -->
        <ListBox Grid.Row="0" Margin="0,0,0,12" ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,4" MinWidth="150">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock x:Name="Status" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="Watched" Text="{Binding WatchedText}"
                                   FontSize="12" Foreground="{StaticResource SeatWatchedBrush}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding WatchedCount}" Value="0">
                            <Setter TargetName="Watched" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter TargetName="Status" Property="Foreground" Value="{StaticResource SoldOutBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Map card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Selection info + actions -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SelectedItem.SelectionText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ActionText}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SeatsTogether, Source={StaticResource T}}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AdjacentOptions}" SelectedItem="{Binding MinAdjacent, Mode=TwoWay}"
                                  MinWidth="72" Margin="0,0,16,0"
                                  ToolTip="{Binding SeatsTogetherToolTip, Source={StaticResource T}}" />
                        <Button Content="{Binding ApplyToAll, Source={StaticResource T}}" Command="{Binding ApplyToAllCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding Clear, Source={StaticResource T}}" Command="{Binding ClearCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Map / placeholder -->
                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding SelectedItem.Map}" Focusable="False" />
                    <TextBlock Text="{Binding SelectedItem.PlaceholderText}" MaxWidth="520" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedItem.HasMap, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>

                <!-- Legend + hint -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="{StaticResource SeatFreeBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LegendFree, Source={StaticResource T}}" Style="{StaticResource CaptionText}" Margin="6,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="14" Height="14" Fill="{StaticResource SeatTakenBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LegendTaken, Source={StaticResource T}}" Style="{StaticResource CaptionText}" Margin="6,0,16,0" VerticalAlignment="Center" />
                        <Ellipse Width="14" Height="14" Stroke="{StaticResource SeatWatchedBrush}" StrokeThickness="3"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LegendWatched, Source={StaticResource T}}" Style="{StaticResource CaptionText}" Margin="6,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Text="&#x267F;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LegendWheelchair, Source={StaticResource T}}" Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding HintText}" Style="{StaticResource CaptionText}"
                               TextAlignment="Right" Margin="24,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
