<UserControl x:Class="CinemaWatch.Views.ScreeningsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ScreeningsTitle, Source={StaticResource T}}" Style="{StaticResource PageTitleText}" />
        <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Margin="0,4,0,16"
                   Text="{Binding ScreeningsIntro, Source={StaticResource T}}" />

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Film, Source={StaticResource T}}" Style="{StaticResource FieldLabelText}" />
                <ComboBox ItemsSource="{Binding Films}" SelectedItem="{Binding SelectedFilm, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" MinWidth="360" HorizontalAlignment="Left"
                          IsEnabled="{Binding HasFilms}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Screenings, Source={StaticResource T}}" Style="{StaticResource SectionHeaderText}"
                               Margin="0" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{Binding SelectAll, Source={StaticResource T}}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding Clear, Source={StaticResource T}}" Command="{Binding ClearAllCommand}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Screenings}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Width="220" Margin="0,0,8,8" Padding="12,10">
                                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Top">
                                                        <StackPanel Margin="2,0,0,0">
                                                            <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" />
                                                            <TextBlock x:Name="Availability" Text="{Binding AvailabilityText}"
                                                                       FontSize="12" Margin="0,4,0,0"
                                                                       Foreground="{StaticResource AvailableBrush}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsNearlySoldOut}" Value="True">
                                                        <Setter TargetName="Availability" Property="Foreground"
                                                                Value="{StaticResource SoldOutBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="{Binding EmptyText}" Style="{StaticResource CaptionText}"
                           Visibility="{Binding HasScreenings, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
