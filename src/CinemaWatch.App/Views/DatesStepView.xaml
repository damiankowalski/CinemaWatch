<UserControl x:Class="CinemaWatch.Views.DatesStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="{Binding DatesTitle, Source={StaticResource T}}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding DatesIntro, Source={StaticResource T}}"
                       Style="{StaticResource CaptionText}" Margin="0,4,0,16" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Cinema, Source={StaticResource T}}" Style="{StaticResource SectionHeaderText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding City, Source={StaticResource T}}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity, Mode=TwoWay}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Cinema, Source={StaticResource T}}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding Cinemas}" SelectedItem="{Binding SelectedCinema, Mode=OneWay}" DisplayMemberPath="Name" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{Binding Technology, Source={StaticResource T}}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding Technologies}" SelectedItem="{Binding SelectedTechnology, Mode=OneWay}" DisplayMemberPath="Name" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding LocationHint, Source={StaticResource T}}"
                               Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Dates, Source={StaticResource T}}" Style="{StaticResource SectionHeaderText}" />
                    <CheckBox Content="{Binding DateRange, Source={StaticResource T}}" IsChecked="{Binding IsRange}" Margin="0,0,0,12" />
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DateFromLabel}" Style="{StaticResource FieldLabelText}" />
                            <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" SelectedDateFormat="Long" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DateTo, Source={StaticResource T}}" Style="{StaticResource FieldLabelText}" />
                            <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" SelectedDateFormat="Long" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding RangeHint}" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                               Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
