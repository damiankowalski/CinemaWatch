<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection is needed for Windows toast notifications. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>CinemaWatch</AssemblyName>
    <RootNamespace>CinemaWatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CinemaWatch.ico</ApplicationIcon>
    <!-- WPF Fluent theme (Application.ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window / taskbar icon (WPF resource) and the PNG used for Windows notifications. -->
    <Resource Include="Assets\CinemaWatch.ico" />
    <EmbeddedResource Include="Assets\CinemaWatch.png" LogicalName="CinemaWatch.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CinemaWatch.Core\CinemaWatch.Core.csproj" />
    <ProjectReference Include="..\CinemaWatch.ViewModels\CinemaWatch.ViewModels.csproj" />
  </ItemGroup>

</Project>
